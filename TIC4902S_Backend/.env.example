# Copy this file to .env and fill in the values. 

# Groq API key for the AI service. Get your own at https://console.groq.com/keys
GROQ_API_KEY=

# Signs JWT login tokens. Use the shared team key so tokens work across everyone's backend.
SECRET_KEY=

# MongoDB connection string. Use the shared Atlas string from the team:
# mongodb+srv://<username>:<password>@<cluster-address>/
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tic4902s

# Optional: how long a login token stays valid, in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
